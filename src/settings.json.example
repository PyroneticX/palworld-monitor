{
    "os": "windows",
    "palworldServerExePath": "C:\\\\steamapps\\\\common\\\\PalServer\\\\PalServer.exe",
    "palworldServerHost": "127.0.0.1",
    "palworldServerPort": 8211,
    "palworldRESTPort": 8212,
    "palworldRCONPort": 25575,
    "palworldServerAdminPassword": "PALWORLD_SERVER_ADMIN_PASSWORD",
    "protocol": "REST",
    "useWebServer": true,
    "webServerPort": 8213,
    "controlServerThroughWeb": true,
    "showServerIPAddress": false,
    "autoStart": true,
    "autoStop": true,
    "autoStopDelay": 600,
    "updateInterval": 30,
    "enablePlayerTracking": true,
    "webUsername": "admin",
    "webPassword": "WEB_INTERFACE_PASSWORD",
    "sessionSecretKey": "GENERATE_WITH_PYTHON_SECRETS_TOKEN_HEX_32",
    "sessionTimeout": 3600,
    "maxLoginAttempts": 5,
    "lockoutDuration": 300,
    "rateLimitEnabled": true,
    "rateLimitRequests": 100,
    "rateLimitWindow": 60
}
