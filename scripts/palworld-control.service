[Unit]
Description=PalWorld Control Application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/palworld-control
ExecStart=/opt/palworld-control/venv/bin/python /opt/palworld-control/src/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/opt/palworld-control/src

[Install]
WantedBy=multi-user.target 